<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\GitHubExtension\Api\GitHubJson.cs" Link="Api\GitHubJson.cs" />
    <Compile Include="..\GitHubExtension\Codespaces\GitHubCodespace.cs" Link="Codespaces\GitHubCodespace.cs" />
    <Compile Include="..\GitHubExtension\Agents\GitHubAgentTask.cs" Link="Agents\GitHubAgentTask.cs" />
    <Compile Include="..\GitHubExtension\Actions\GitHubWorkflowRun.cs" Link="Actions\GitHubWorkflowRun.cs" />
    <Compile Include="..\GitHubExtension\Pages\CreateCodespaceCards.cs" Link="Pages\CreateCodespaceCards.cs" />
    <Compile Include="..\GitHubExtension\Pages\CreateAgentTaskCards.cs" Link="Pages\CreateAgentTaskCards.cs" />
    <Compile Include="..\GitHubExtension\Pages\RerunWorkflowCards.cs" Link="Pages\RerunWorkflowCards.cs" />
  </ItemGroup>
</Project>
