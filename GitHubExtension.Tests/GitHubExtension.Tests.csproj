<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Platforms>x64;ARM64</Platforms>
    <NoWarn>CA1707</NoWarn>
    <AssemblyName>BaldBeardedBuilder.GitHubExtension.Tests</AssemblyName>
    <RootNamespace>BaldBeardedBuilder.CmdPal.GitHub.Tests</RootNamespace>
    <WindowsSdkPackageVersion>10.0.26100.68-preview</WindowsSdkPackageVersion>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Moq" />
    <PackageReference Include="MSTest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GitHubExtension\GitHubExtension.csproj" />
    <None Include="..\GitHubExtension\GitHubExtension.csproj" Link="GitHubExtension.csproj" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
